{
"App":{
			"database":{
					"vuln_path":"data/vuln.db"
					"modules_path":"data/modules.db			
			}, 
			"info":{
					"version":"V1.0.1"
			}, 
	}, 
	"environment":{
			"os":"-1", 
			"root":"unknown"
			
	}	
}


{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project Dynamically (Windows)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "& { mkdir bin -Force; g++ -g @(Get-ChildItem -Recurse -Filter '*.cpp' src | ForEach-Object { $_.FullName }) -Iinclude -Llib -lA -lB -o bin/project.exe }"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
